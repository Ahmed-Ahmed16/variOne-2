// varione_secrets.h — LOCAL, GITIGNORED seed file.
//
// Responsibility: provide the device's home WiFi credential(s) and the Gemini
// AI Studio key at compile time so they can be seeded into bruceConfig at first
// boot WITHOUT typing anything on the on-screen keyboard. Implements the
// "seeded creds" path of the AI-Powered Debrief plan (Part A).
//
// Usage:
//   1. Copy this file to  varione_secrets.h  (same directory).
//   2. Fill in your real values below.
//   3. Build. config.cpp picks it up via __has_include and seeds any BLANK
//      entries (never overwrites values you later set via the web form).
//
// The real varione_secrets.h is gitignored — never commit secrets. The build
// also works fine with NO secrets file at all (everything just stays blank,
// provision via the AI Setup web form instead).

#pragma once

// Primary home WiFi (required for internet / Gemini). Leave SSID "" to skip.
#define VARIONE_WIFI_SSID "YourHomeSSID"
#define VARIONE_WIFI_PASS "YourHomePassword"

// Optional backup networks — any number of {SSID, password} pairs.
// All get seeded; wifiConnecttoKnownNet() tries saved nets until one connects.
// #define VARIONE_WIFI_NETS { {"CafeWiFi", "cafepass"}, {"Phone Hotspot", "hotpass"}, {"Lab-AP", "labpass"} }

// Gemini AI Studio key (https://aistudio.google.com/apikey). Leave "" to skip.
#define VARIONE_GEMINI_KEY ""
